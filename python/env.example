# Modo del adaptador: sim (sin hardware) o real (pymycobot por USB)
MYCOBOT_MODE=sim
MYCOBOT_PORT=/dev/ttyUSB0
MYCOBOT_BAUDRATE=115200
CONSOLE_COMMAND_TIMEOUT=5

# Servicio Python
CONSOLE_HOST=127.0.0.1
CONSOLE_HTTP_PORT=8000
# Si se define, Next.js debe usar el mismo valor en su entorno
CONSOLE_TOKEN=

# Solo para Next.js: URL del servicio Python
PYTHON_CONSOLE_URL=http://127.0.0.1:8000
